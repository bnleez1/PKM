{
  "name": "page-banner",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./components": "./dist/components/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "../../node_modules/.bin/esbuild src/index.ts src/components/index.ts --bundle --platform=node --format=esm --target=es2022 --jsx=automatic --jsx-import-source=preact --external:preact --external:preact/* --outdir=dist --outbase=src"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "quartz": {
    "name": "page-banner",
    "displayName": "Page Banner",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "PageBanner": {
        "displayName": "Page Banner",
        "defaultPosition": "beforeBody",
        "defaultPriority": 8
      }
    }
  }
}
